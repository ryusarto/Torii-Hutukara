  "actions": {
    "idle": [
      "Eight subtly distinct breathing frames. Small chest rise, soft knee weight shift, elbows settle, one blink, neutral face. Ryuchi holds sticks above pads; Franco hands rest over keys. Seamless eighth-to-first loop.",
      120,
      true
    ],
    "walk": [
      "Complete eight-frame WALK cycle in place: left contact/down/pass/up, right contact/down/pass/up. Opposed leg movement, short legs, slight shoulder counterrotation, instrument bobs on strap. Fixed facing, no turning. Seamless loop.",
      95,
      true
    ],
    "run": [
      "Complete eight-frame RUN cycle: contact, compress, push, flight, opposite contact, compress, push, flight. Forward lean, clearly alternating stubby legs, brief both-feet-airborne phase. Hold strapped instrument securely. Seamless loop.",
      65,
      true
    ],
    "roll": [
      "DODGE/ROLL eight frames: ready, crouch, shoulder drop, tuck, curled midroll, foot plant, rise, ready. Chibi body actually rotates anatomically. Instrument remains strapped close to torso, mask attached in masked variant. Never replace roll with upright slide.",
      65,
      false
    ],
    "attack_1": [
      "FIRST COMBO HIT, eight frames ready/anticipate/lift/contact/follow-through/recoil/reset/ready. Ryuchi RIGHT drumstick strikes first pad, left poised. Franco LEFT hand plays low chord, right adjusts knob. Clear hand motion, no visual effects.",
      65,
      false
    ],
    "attack_2": [
      "SECOND COMBO HIT, eight frames ready/opposite anticipation/load/contact/follow-through/rebound/reset/ready. Ryuchi LEFT drumstick strikes alternate pad, right rebounds. Franco RIGHT hand plays higher notes, left control sweep. Distinct from hit1; no effects.",
      65,
      false
    ],
    "attack_3": [
      "THIRD COMBO FINISHER, eight frames ready/deep knee load/both arms prepare high/forceful double contact/full follow-through/rebound/recover/ready. Ryuchi BOTH sticks strike pads with broad accent. Franco powerful TWO-HANDED wide chord. Instrument stays attached, no effects.",
      75,
      false
    ],
    "skill": [
      "TECHNIQUE Z, eight frames ready/anticipate/prepare/contact/sustain/release/recover/ready. Ryuchi rapid controlled ALTERNATING two-stick roll with visible wrist/elbow changes. Franco left-hand sustained chord while right hand smoothly sweeps filter knob. No effects, same instrument.",
      80,
      false
    ],
    "advanced": [
      "ADVANCED TECHNIQUE X, eight frames ready/anticipate/guard/respond/peak counter/follow-through/recover/ready. Ryuchi CROSSES both drumsticks defensively above drum then opens arms into strong syncopated double beat. Franco braces keyboard and makes broad control sweep then powerful chord. Clear guarded/contact/recovery differences, no effects.",
      70,
      false
    ],
    "signature": [
      "SPECIAL K, eight frames ready/deep crouch charging/arms rise/explosive playing/peak forward lean/resonant follow-through/recover/ready. Ryuchi overhead two-stick flourish then emphatic DOUBLE PAD STRIKE. Franco arm flourish above keyboard then deep TWO-HANDED CHORD, never guitar pose. Large readable chibi gesture, no effects.",
      90,
      false
    ],
    "hurt": [
      "HURT eight frames ready/sudden recoil/max recoil with pained face/knees buckle/protect instrument/regain balance/straighten/ready. Instrument and sticks stay attached/held. No blood, no new costume damage. Continuous whole-body recoil.",
      65,
      false
    ],
    "defeat": [
      "DEFEAT eight frames ready/stagger/knees collapse/one knee down/fall onto side protecting instrument/reach floor/settle/final SIDE-LYING PRONE pose. Final frame MUST remain on floor, never stand up. All four directions have clearly horizontal final body, instrument still attached beside torso. No blood or effects.",
      110,
      false
    ],
    "performance": [
      "PLAYING/INTERACTION eight-frame rhythmic loop. Ryuchi clearly alternating RIGHT raised/contact/rebound then LEFT raised/contact/rebound strokes, head nod and knee bounce. Franco both hands play melodic keyboard phrase, small finger changes and occasional control adjustment, head nods. Instrument shape fixed. Seamless loop.",
      85,
      true
    ]
  },
